# replace your_db_user and your_db_password with your actual database credentials
# replace your_jwt_secret_key with the actual secret key
# and rename this file to .env before running the application
SERVER_ADDRESS=:8080

DATABASE_URL=postgres://your_db_user:your_db_password@localhost:5432/school_db?sslmode=disable

JWT_SECRET=your_jwt_secret_key